!.env.example
*.key
*.pem
secrets/
**/*api_key*
**/*apikey*

# Launcher install artifact: install.ps1/.sh writes the absolute host path of
# the project root next to the launcher so it can find docker-compose.yml. It is
# machine-specific and must never be committed.
/deploy/console/project-root.txt

