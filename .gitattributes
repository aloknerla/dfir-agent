# Reproducibility fingerprints are computed from canonical source bytes.
# Pin all research/code text artifacts to LF so checkout platform cannot change
# scorer, prompt, registry, or manifest digests.
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.cff text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Files consumed byte-for-byte by a POSIX shell or by Linux-side container
# tooling. A lone CR here is not cosmetic: /bin/sh reads `then\r` as a command
# name, so a CRLF checkout produces an image whose entrypoint cannot parse.
.env.example text eol=lf
*.env text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# Binarne artefakte Git ne smije normalizirati niti prikazivati kao tekstualni diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.zip binary
